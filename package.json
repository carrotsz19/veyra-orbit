{
  "name": "veyra-orbit",
  "productName": "Veyra Orbit",
  "version": "26.11.8",
  "description": "Veyra Orbit: a calm study browser from Veyra.",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "test": "node --test tests/url.test.ts tests/suggest.test.ts tests/store.test.ts tests/format.test.ts tests/downloads.test.ts tests/settings.test.ts tests/appearance.test.ts tests/startpage.test.ts tests/external.test.ts tests/updates.test.ts tests/release.test.ts tests/compat.test.ts tests/workspaces.test.ts tests/sleep.test.ts tests/compact.test.ts tests/menu.test.ts tests/split.test.ts tests/palette.test.ts tests/peek.test.ts tests/importer.test.ts tests/extensions.test.ts",
    "icons:generate": "node tools/generate-icons.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "postinstall": "node node_modules/electron/install.js",
    "dist:dev": "node tools/dist-dev.mjs",
    "release:dev": "node tools/release-dev.mjs"
  },
  "build": {
    "appId": "app.veyra.orbit",
    "productName": "Veyra Orbit",
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "carrotsz19",
        "repo": "veyra-orbit",
        "releaseType": "release"
      }
    ],
    "artifactName": "Veyra-Orbit-Setup-${version}.${ext}"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.72.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "electron@45.3.0": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-updater": "^6.8.11"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "minimatch@^9.0.0": "^11.0.1",
    "minimatch@^10.0.0": "^11.0.1"
  }
}
